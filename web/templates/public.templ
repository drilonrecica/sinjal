package templates

import (
	"strconv"

	"github.com/drilonrecica/sinjal/internal/assets"
)

// PublicLayout is the document of a public status page: the page's own
// theme and accent, the public stylesheet, no admin shell and no script.
// refresh asks the browser to reload the page every PublicRefreshSeconds
// (a plain meta refresh: the page has no script and never opens /events).
templ PublicLayout(page Page, accentCSS string, noIndex bool, refresh bool) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ page.Theme } data-density={ page.Density } data-ambient={ page.Ambient() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ page.ColorScheme() }/>
			if noIndex {
				<meta name="robots" content="noindex, nofollow"/>
			}
			if refresh {
				<meta http-equiv="refresh" content={ strconv.Itoa(PublicRefreshSeconds) }/>
			}
			<title>{ page.Title }</title>
			<link rel="icon" type="image/svg+xml" href={ assets.URL("img/favicon.svg") }/>
			<link rel="preload" href={ assets.URL("fonts/inter-var.woff2") } as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ assets.URL("css/tokens.css") }/>
			<link rel="stylesheet" href={ assets.URL("css/base.css") }/>
			<link rel="stylesheet" href={ assets.URL("css/components.css") }/>
			for _, name := range page.Styles {
				<link rel="stylesheet" href={ assets.URL(name) }/>
			}
			if accentCSS != "" {
				@templ.Raw("<style>" + accentCSS + "</style>")
			}
		</head>
		<body class="public">
			{ children... }
		</body>
	</html>
}

// PublicStatusPage is a status page as its visitors see it (docs/12
// "Layouts", docs/33 "Status page components"): one component per layout,
// each arranging the shared partials below, and that layout's stylesheet.
templ PublicStatusPage(v PublicPage, theme string) {
	{{ layout := publicLayout(v.Layout) }}
	@PublicLayout(publicPage(v.Title, theme, layout), v.AccentCSS, v.NoIndex, true) {
		switch layout {
			case LayoutSignal:
				@signalPage(v)
			case LayoutSentence:
				@sentencePage(v)
			case LayoutHeartline:
				@heartlinePage(v)
			case LayoutLogbook:
				@logbookPage(v)
		}
	}
}

// signalPage is the Signal layout (docs/12 "Signal"): one answer at a
// glance. data-overall sets --lamp, the colour of the lamp, its ring and
// its halo (public_signal.css); data-state on the hero colours the
// Ambient light behind it.
templ signalPage(v PublicPage) {
	<div class="public-page" data-layout="signal" data-overall={ v.Overall }>
		@publicHeader(v)
		<main>
			<section class="public-hero signal-hero" data-state={ v.HeroState } aria-labelledby="overall">
				@statusLamp(v.Overall)
				<h1 id="overall">{ signalHeadline(v) }</h1>
				<p class="signal-meta">{ signalMeta(v) }Updated <time datetime={ v.GeneratedAt }>{ v.Generated }</time></p>
				if v.Note != nil {
					@publicNote(*v.Note)
				}
			</section>
			for _, g := range v.Groups {
				@signalGroup(g)
			}
			if len(v.Groups) > 0 {
				@publicAxis()
			}
			<section class="signal-incidents" aria-labelledby="incidents">
				<h2 id="incidents">Incidents</h2>
				if len(v.Incidents) == 0 {
					<p class="public-quiet">No incidents in the last { pluralDays(v.IncidentDays) }.</p>
				} else {
					<ol class="signal-incident-list" role="list">
						for _, in := range v.Incidents {
							@signalIncident(in)
						}
					</ol>
				}
			</section>
		</main>
		@publicFooter(v)
	</div>
}

// statusLamp is the hero's lamp (docs/04 "Status lamp"): the halo that
// breathes, the lit bulb and the overall state's glyph inside it. The
// headline next to it carries the words, so the lamp is decoration to a
// reader.
templ statusLamp(overall string) {
	<div class="signal-lamp" aria-hidden="true">
		<span class="signal-halo"></span><span class="signal-bulb">@Icon(overallIcon(overall))</span>
	</div>
}

// signalGroup is a group's name with its summary in words on the right,
// then its services as cards in two columns (one on phones).
templ signalGroup(g PublicGroup) {
	{{ summary, state := signalGroupSummary(g) }}
	<section class="signal-group" aria-label={ groupLabel(g) }>
		<div class="signal-group-head">
			<h2 class="signal-group-name">{ groupLabel(g) }</h2>
			<p
				class="signal-group-summary"
				if state != "" {
					data-state={ state }
				}
			>{ summary }</p>
		</div>
		<ul class="signal-cards" role="list">
			for _, row := range g.Rows {
				@signalCard(row)
			}
		</ul>
	</section>
}

// signalCard is one service: a mini lamp, its name, its state in words
// (Terminal shows the tag) with the latency where shown, the 90-day uptime
// figure on the right and the strip under them.
templ signalCard(row PublicRow) {
	<li class="signal-card" data-state={ row.State }>
		<div class="signal-card-head">
			<div class="signal-card-id">
				<p class="signal-card-name"><span class="signal-dot"></span>{ row.Name }</p>
				<p class="signal-card-state"><span class="status-text">{ publicStateLabel(row.State) }</span><span class="status-tag" aria-hidden="true">{ publicStateTag(row.State) }</span>{ signalLatency(row) }</p>
			</div>
			<p class="signal-card-figure"><span class="signal-card-uptime">{ row.Uptime }</span><small>90-day uptime</small></p>
		</div>
		@PublicDayBars(row)
	</li>
}

// signalIncident is one listed incident: its day and time, the service
// with an Ongoing or Resolved badge, how long it was (or has been) down,
// and its notes.
templ signalIncident(in PublicIncident) {
	<li class="signal-incident" data-active?={ in.Active }>
		<p class="signal-incident-when"><time datetime={ in.StartedAt }>{ in.Date }, { in.Time }</time></p>
		<div class="signal-incident-body">
			<p class="signal-incident-head"><span class="signal-incident-service">{ in.Service }</span><span class="signal-badge">{ signalBadge(in.Active) }</span></p>
			<p class="signal-incident-duration">
				if in.Active {
					Down for { in.Short } so far
				} else {
					Down for { in.Short }
				}
			</p>
			@publicNotes(in.Notes)
		</div>
	</li>
}

// sentencePage is the Sentence layout (docs/12 "Sentence"): the page reads
// like a short note. data-overall colours the rule across the top of the
// page, the headline's verb and the quote's rule (public_sentence.css).
templ sentencePage(v PublicPage) {
	<div class="public-page" data-layout="sentence" data-overall={ v.Overall }>
		@publicHeader(v)
		<main>
			<section class="sentence-hero" aria-labelledby="overall">
				switch v.Overall {
					case OverallNone:
						<h1 id="overall">Nothing is monitored on this page yet.</h1>
					case OverallUp:
						<h1 id="overall">Everything at { v.Title } is working.</h1>
						<p class="sentence-sub">{ v.LastIssue }</p>
					default:
						<h1 id="overall">{ v.Names }{ " " }<span class="sentence-verb">{ v.Verb }.</span></h1>
						if sub := sentenceSub(v); sub != "" {
							<p class="sentence-sub">{ sub }</p>
						}
						if v.Note != nil {
							@publicNote(*v.Note)
						}
				}
				<p class="sentence-meta">Updated <time datetime={ v.GeneratedAt }>{ v.Generated }</time>{ sentenceMeta(v) }</p>
			</section>
			for _, g := range v.Groups {
				@publicGroup(g)
			}
			if len(v.Groups) > 0 {
				@publicAxis()
			}
			<section class="public-incidents" aria-labelledby="incidents">
				<h2 class="public-group-name" id="incidents">The last { pluralDays(v.IncidentDays) }</h2>
				if len(v.Incidents) == 0 {
					<p class="public-quiet">No incidents in the last { pluralDays(v.IncidentDays) }.</p>
				} else {
					<ol class="public-incident-list" role="list">
						for _, in := range v.Incidents {
							@publicIncident(in)
						}
					</ol>
				}
			</section>
		</main>
		@publicFooter(v)
	</div>
}

// publicGroup is a group's label over its services. Services outside any
// group are labelled "Services".
templ publicGroup(g PublicGroup) {
	<section class="public-group" aria-label={ groupLabel(g) }>
		<h2 class="public-group-name">{ groupLabel(g) }</h2>
		<ul class="public-services" role="list">
			for _, row := range g.Rows {
				@publicRow(row)
			}
		</ul>
	</section>
}

// publicRow is one service: its name, a dotted leader and its state in
// words (Terminal shows the tag instead); under it the 90-day strip and
// its downtime in human time.
templ publicRow(row PublicRow) {
	<li class="public-service" data-state={ row.State }>
		<div class="public-service-head">
			<span class="public-service-name">{ row.Name }</span>
			<span class="public-service-state">
				<span class="public-glyph">@Icon(publicStateIcon(row.State))</span>
				<span class="status-text">{ publicStateLabel(row.State) }</span><span class="status-tag" aria-hidden="true">{ publicStateTag(row.State) }</span>
			</span>
		</div>
		<div class="public-service-strip">
			@PublicDayBars(row)
			if row.Downtime != "" {
				<span class="public-service-downtime">{ row.Downtime }</span>
			}
		</div>
	</li>
}

// logbookPage is the Logbook layout (docs/12 "Logbook"): what happened,
// when and what was said. data-overall colours the hero's disc
// (public_logbook.css). It leaves out the strips and the axis: the
// calendar carries the 90 days for every service.
templ logbookPage(v PublicPage) {
	<div class="public-page" data-layout="logbook" data-overall={ v.Overall }>
		@publicHeader(v)
		<main>
			<section class="logbook-hero" aria-labelledby="overall">
				<span class="logbook-disc" aria-hidden="true">@Icon(overallIcon(v.Overall))</span>
				<div class="logbook-hero-text">
					<h1 id="overall">{ signalHeadline(v) }</h1>
					<p class="logbook-sub">{ logbookSub(v) }Updated <time datetime={ v.GeneratedAt }>{ v.Generated }</time>.</p>
				</div>
			</section>
			@logbookCalendar(v)
			if len(v.Groups) > 0 {
				<section class="logbook-services" aria-labelledby="services">
					<h2 id="services">Services</h2>
					<ul class="logbook-service-list" role="list">
						for _, g := range v.Groups {
							for _, row := range g.Rows {
								@logbookService(g, row)
							}
						}
					</ul>
				</section>
			}
			<section class="logbook-log" aria-labelledby="logbook">
				<h2 id="logbook">Logbook</h2>
				if len(v.Incidents) == 0 {
					<p class="public-quiet">No incidents in the last { pluralDays(v.IncidentDays) }.</p>
				} else {
					<ol class="logbook-entries" role="list">
						for _, in := range logbookOrder(v.Incidents) {
							@logbookEntry(in)
						}
					</ol>
				}
			</section>
		</main>
		@publicFooter(v)
	</div>
}

// logbookCalendar is the calendar card (docs/04 "Calendar"): the legend,
// then one grid of cells placed by attributes into either the month rows
// of desktop (data-m, data-d) or the week rows of phones (data-w,
// data-wd), with both sets of row and column labels. A day with a listed
// incident is a link to itself, followed by its panel, which its :target
// opens; the newest such day is marked and open without a target. The
// rest of the current month follows, dashed; the days after this week
// are marked so phones leave them out.
templ logbookCalendar(v PublicPage) {
	{{ newest := newestIncidentDay(v.Calendar) }}
	{{ todayWeek := 0 }}
	if n := len(v.Calendar); n > 0 {
		{{ todayWeek = v.Calendar[n-1].Week }}
	}
	<section class="logbook-card" aria-labelledby="calendar">
		<div class="logbook-card-head">
			<h2 id="calendar">The last 90 days, all services</h2>
			<ul class="cal-legend" role="list">
				for _, l := range calendarLegend {
					<li><span class="cal-swatch" data-day={ l.Class }></span>{ l.Word }</li>
				}
			</ul>
		</div>
		<div class="cal">
			for _, n := range calendarDoms {
				<span class="cal-dom" data-d={ strconv.Itoa(n) } aria-hidden="true">{ strconv.Itoa(n) }</span>
			}
			for i, w := range calendarWeekdays {
				<span class="cal-wd" data-wd={ strconv.Itoa(i + 1) } aria-hidden="true">{ w }</span>
			}
			for i, m := range v.CalendarMonths {
				<span class="cal-month" data-m={ strconv.Itoa(i) } aria-hidden="true">{ m }</span>
			}
			for i, w := range v.CalendarWeeks {
				<span class="cal-week" data-w={ strconv.Itoa(i) } aria-hidden="true">{ w }</span>
			}
			for i, d := range v.Calendar {
				if len(d.Incidents) > 0 {
					<a
						class="cal-day"
						id={ "day-" + d.Date }
						href={ templ.SafeURL("#day-" + d.Date) }
						data-day={ d.Class }
						data-m={ strconv.Itoa(d.Month) }
						data-d={ strconv.Itoa(d.Dom) }
						data-w={ strconv.Itoa(d.Week) }
						data-wd={ strconv.Itoa(d.Weekday) }
						data-today?={ i == len(v.Calendar)-1 }
						data-newest?={ i == newest }
						title={ calendarWords(d) }
					><span class="visually-hidden">{ calendarWords(d) }</span></a>
					@logbookDayPanel(v, d, i == newest)
				} else {
					<span
						class="cal-day"
						data-day={ d.Class }
						data-m={ strconv.Itoa(d.Month) }
						data-d={ strconv.Itoa(d.Dom) }
						data-w={ strconv.Itoa(d.Week) }
						data-wd={ strconv.Itoa(d.Weekday) }
						data-today?={ i == len(v.Calendar)-1 }
						title={ calendarWords(d) }
					><span class="visually-hidden">{ calendarWords(d) }</span></span>
				}
			}
			for _, d := range v.CalendarUpcoming {
				<span
					class="cal-day"
					data-day="future"
					data-m={ strconv.Itoa(d.Month) }
					data-d={ strconv.Itoa(d.Dom) }
					data-w={ strconv.Itoa(d.Week) }
					data-wd={ strconv.Itoa(d.Weekday) }
					data-later?={ d.Week > todayWeek }
					title={ calendarWords(d) }
				><span class="visually-hidden">{ calendarWords(d) }</span></span>
			}
		</div>
	</section>
}

// logbookDayPanel is an opened day: its title, the day's incidents as
// sentences with their notes, and that every other service was fine
// when it was (and there is another service).
templ logbookDayPanel(v PublicPage, d PublicDay, newest bool) {
	<section class="cal-panel" data-newest?={ newest } aria-labelledby={ "day-" + d.Date + "-title" }>
		<h3 id={ "day-" + d.Date + "-title" }>{ d.Long }</h3>
		for _, j := range d.Incidents {
			<div class="cal-panel-incident">
				@publicIncidentSentence(v.Incidents[j])
				@publicNotes(v.Incidents[j].Notes)
			</div>
		}
		if d.OthersFine && v.Services > 1 {
			<p class="cal-panel-rest">Every other service had no issues.</p>
		}
	</section>
}

// logbookService is one row of the services list: a dot, the name with
// its group muted beside it (an empty span, hidden, for a service outside
// any group), the state, the uptime figure (or since when) and the
// latency where shown.
templ logbookService(g PublicGroup, row PublicRow) {
	<li class="logbook-service" data-state={ row.State }>
		<p class="logbook-service-name"><span class="logbook-dot"></span><span>{ row.Name }</span> <span class="logbook-service-group">{ g.Name }</span></p>
		<p class="logbook-service-state"><span class="status-text">{ publicStateLabel(row.State) }</span><span class="status-tag" aria-hidden="true">{ publicStateTag(row.State) }</span></p>
		if f := logbookFigure(row); f != "" {
			<p class="logbook-service-uptime">{ f }</p>
		}
		if l := logbookLatency(row); l != "" {
			<p class="logbook-service-latency">{ l }</p>
		}
	</li>
}

// logbookEntry is one entry of the timeline: when, the sentence and the
// notes, or that none was published.
templ logbookEntry(in PublicIncident) {
	<li class="logbook-entry" data-active?={ in.Active }>
		<p class="logbook-entry-when"><time datetime={ in.StartedAt }>{ logbookWhen(in) }</time></p>
		<p class="logbook-entry-title">{ logbookTitle(in) }</p>
		if len(in.Notes) == 0 {
			<p class="public-note logbook-no-note">No note was published.</p>
		} else {
			@publicNotes(in.Notes)
		}
	</li>
}

// heartlinePage is the Heartline layout (docs/12 "Heartline"): how each
// service is responding now. data-state on the hero colours the Ambient
// light and the live dot (public_heartline.css). It leaves out the
// calendar and the downtime sentence; the pulse carries the last 24 hours.
templ heartlinePage(v PublicPage) {
	<div class="public-page" data-layout="heartline" data-overall={ v.Overall }>
		@publicHeader(v)
		<main>
			<section class="public-hero heartline-hero" data-state={ v.HeroState } aria-labelledby="overall">
				<div class="heartline-hero-text">
					<p class="heartline-live"><span class="heartline-dot" aria-hidden="true"></span>Live · Updated <time datetime={ v.GeneratedAt }>{ v.Generated }</time></p>
					<h1 id="overall">{ signalHeadline(v) }</h1>
				</div>
				if v.Overall != OverallNone {
					<dl class="heartline-figures">
						<div><dt>Uptime, 90 days</dt><dd>{ v.Uptime }</dd></div>
						if v.MedianLatency != "" {
							<div><dt>Response, median</dt><dd>{ v.MedianLatency }</dd></div>
						}
					</dl>
				}
			</section>
			if v.Note != nil {
				@publicNote(*v.Note)
			}
			if len(v.Groups) > 0 {
				<p class="heartline-legend" aria-hidden="true"><span>Service</span><span><span>Response · 24 h ago</span><span>Now</span></span><span>Now</span></p>
				for _, g := range v.Groups {
					@heartlinePanel(g)
				}
				@publicAxis()
			}
			<section class="heartline-incidents" aria-labelledby="incidents">
				<h2 id="incidents">Incidents</h2>
				if len(v.Incidents) == 0 {
					<p class="public-quiet">No incidents in the last { pluralDays(v.IncidentDays) }.</p>
				} else {
					<ol class="heartline-incident-list" role="list">
						for _, in := range v.Incidents {
							@heartlineIncident(in)
						}
					</ol>
				}
			</section>
		</main>
		@publicFooter(v)
	</div>
}

// heartlinePanel is a group as a panel: its name in the head, then one
// row per service.
templ heartlinePanel(g PublicGroup) {
	<section class="heartline-panel" aria-label={ groupLabel(g) }>
		<h2 class="heartline-panel-head">{ groupLabel(g) }</h2>
		<ul class="heartline-rows" role="list">
			for _, row := range g.Rows {
				@heartlineRow(row)
			}
		</ul>
	</section>
}

// heartlineRow is one service: its name and state ("Operational · 99.98%
// in 90 days", "Down since 13:52"), then, where the page shows its
// latency, the pulse and the current figure ("71 ms", "no reply"), and
// under them the thin 90-day strip. Without latency the strip stands in
// the pulse's place at full height (data-pulse is absent).
templ heartlineRow(row PublicRow) {
	<li class="heartline-row" data-state={ row.State } data-pulse?={ row.Pulse != nil }>
		<div class="heartline-row-id">
			<p class="heartline-row-name">{ row.Name }</p>
			<p class="heartline-row-state"><span class="status-text">{ publicStateLabel(row.State) }</span><span class="status-tag" aria-hidden="true">{ publicStateTag(row.State) }</span>{ heartlineStateSuffix(row) }</p>
		</div>
		if row.Pulse != nil {
			{{ figure, sub := heartlineFigure(row) }}
			@pulse(*row.Pulse)
			<p class="heartline-figure"><span class="heartline-ms">{ figure }</span><small>{ sub }</small></p>
		}
		@PublicDayBars(row)
	</li>
}

// pulse is a service's 24-hour response pulse (docs/04 "Response
// pulse"): an SVG image with its summary as label, in a fixed viewBox that
// stretches to its box while the strokes keep their width; the area, the
// line, the dashed tail while down and the dot at the end. The scan line
// that sweeps over it is a span the stylesheet moves.
templ pulse(p Pulse) {
	<div class="pulse">
		<svg class="pulse-svg" viewBox="0 0 960 64" preserveAspectRatio="none" role="img" aria-label={ p.Text }>
			if p.Area != "" {
				<path class="pulse-area" d={ p.Area }></path>
			}
			if p.Line != "" {
				<path class="pulse-line" d={ p.Line } vector-effect="non-scaling-stroke"></path>
			}
			if p.Tail != "" {
				<path class="pulse-tail" d={ p.Tail } vector-effect="non-scaling-stroke"></path>
			}
			if p.End != "" {
				<path class="pulse-end" d={ p.End } vector-effect="non-scaling-stroke"></path>
			}
		</svg>
		<span class="pulse-scan" aria-hidden="true"></span>
	</div>
}

// heartlineIncident is one listed incident: its day and time in mono, the
// service with "down 12 min, resolved" or "down 18 min, ongoing", and its
// notes.
templ heartlineIncident(in PublicIncident) {
	<li class="heartline-incident" data-active?={ in.Active }>
		<p class="heartline-incident-when"><time datetime={ in.StartedAt }>{ in.Date } { in.Time }</time></p>
		<div class="heartline-incident-body">
			<p class="heartline-incident-head"><span class="heartline-incident-service">{ in.Service }</span> · <span class="heartline-incident-duration">{ heartlineDuration(in) }</span></p>
			@publicNotes(in.Notes)
		</div>
	</li>
}

// The partials every layout shares (docs/12 "What every layout shares").

// publicHeader is the logo, the title, the description and the Subscribe
// link to the page's feed. The title is not a heading: the page's h1 is
// its status.
templ publicHeader(v PublicPage) {
	<header class="public-header">
		if v.Logo != "" {
			<img class="public-logo" src={ v.Logo } alt=""/>
		}
		<div class="public-title">
			<p class="public-title-name">{ v.Title }</p>
			if v.Description != "" {
				<p class="public-description">{ v.Description }</p>
			}
		</div>
		if v.FeedURL != "" {
			<a class="public-subscribe" href={ templ.SafeURL(v.FeedURL) }>
				@Icon("rss")
				<span>Subscribe</span>
			</a>
		}
	</header>
}

// publicFooter is the time zone note and "Powered by Sinjal", which the
// page may turn off.
templ publicFooter(v PublicPage) {
	<footer class="public-footer">
		<p>Times in { v.Zone }. The page refreshes every minute.</p>
		if v.PoweredBy {
			<p>Powered by <a href="https://github.com/drilonrecica/sinjal">Sinjal</a></p>
		}
	</footer>
}

// publicNote is the newest published note of an ongoing incident, shown
// in the hero as a quote with its time and service.
templ publicNote(n PublicNote) {
	<blockquote class="public-hero-note">
		<p>{ n.Message }</p>
		<p class="public-hero-note-meta">Update at <time datetime={ n.At }>{ n.Time }</time>{ " · " + n.Service }</p>
	</blockquote>
}

// publicIncident is one listed incident as a sentence, with its day on
// the side and its published notes as quotes with their times.
templ publicIncident(in PublicIncident) {
	<li class="public-incident" data-active?={ in.Active }>
		<p class="public-incident-date"><time datetime={ in.StartedAt }>{ in.Date }</time></p>
		<div class="public-incident-body">
			@publicIncidentSentence(in)
			@publicNotes(in.Notes)
		</div>
	</li>
}

// publicIncidentSentence is an incident in one sentence, with its start
// time: "Scaneks.com was down for 12 minutes, from 09:14." or "Scaneks.com
// has been down since 13:52."
templ publicIncidentSentence(in PublicIncident) {
	<p class="public-incident-text">
		if in.Active {
			{ in.Service } has been down since <time datetime={ in.StartedAt }>{ in.Time }</time>.
		} else {
			{ in.Service } was down for { in.Long }, from <time datetime={ in.StartedAt }>{ in.Time }</time>.
		}
	</p>
}

// publicNotes are an incident's published notes, each a quote with its
// time after it; every layout quotes them the same way.
templ publicNotes(notes []PublicNote) {
	for _, n := range notes {
		<p class="public-note"><q>{ n.Message }</q>{ " " }<time datetime={ n.At }>{ n.Time }</time></p>
	}
}

// PublicDayBars is a service's 90-day strip in the "Monitoring since"
// form: the days before its first day with data are a dashed line, with
// the label over it when there is room (sinceFits).
templ PublicDayBars(row PublicRow) {
	@DayBarsSince(row.Days, row.SinceDay, sinceText(row), row.StripText)
}

// publicAxis is the page's one "90 days ago … Today" axis, under the last
// strips. The strips' own labels carry their dates.
templ publicAxis() {
	<p class="public-axis" aria-hidden="true"><span>90 days ago</span><span>Today</span></p>
}

// PublicPasswordPage asks for a page's password (docs/12 "Password-protected").
templ PublicPasswordPage(v PublicPasswordView, theme string) {
	@PublicLayout(publicPage(v.Title, theme, ""), "", false, false) {
		<div class="public-page public-locked">
			<main>
				<h1>{ v.Title }</h1>
				<form class="public-password" method="post" action={ templ.SafeURL(v.Action) }>
					if v.CSRFToken != "" {
						<input type="hidden" name="_csrf" value={ v.CSRFToken }/>
					}
					<label for="password">This page is protected. Enter its password to see it.</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						if v.Error != "" {
							aria-invalid="true"
							aria-describedby="password-error"
						}
					/>
					if v.Error != "" {
						<p id="password-error" class="public-error" role="alert">{ v.Error }</p>
					}
					<button type="submit">Open the page</button>
				</form>
			</main>
		</div>
	}
}

// PublicMessagePage explains why a page cannot be shown here.
templ PublicMessagePage(title, message, theme string) {
	@PublicLayout(publicPage(title, theme, ""), "", false, false) {
		<div class="public-page public-locked">
			<main>
				<h1>{ title }</h1>
				<p>{ message }</p>
			</main>
		</div>
	}
}
