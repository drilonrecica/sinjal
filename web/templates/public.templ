package templates

import (
	"strconv"

	"github.com/drilonrecica/sinjal/internal/assets"
)

// PublicLayout is the document of a public status page: the page's own
// theme and accent, the public stylesheet, no admin shell and no script.
// refresh asks the browser to reload the page every PublicRefreshSeconds
// (a plain meta refresh: the page has no script and never opens /events).
templ PublicLayout(page Page, accentCSS string, noIndex bool, refresh bool) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ page.Theme } data-density={ page.Density } data-ambient={ page.Ambient() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ page.ColorScheme() }/>
			if noIndex {
				<meta name="robots" content="noindex, nofollow"/>
			}
			if refresh {
				<meta http-equiv="refresh" content={ strconv.Itoa(PublicRefreshSeconds) }/>
			}
			<title>{ page.Title }</title>
			<link rel="icon" type="image/svg+xml" href={ assets.URL("img/favicon.svg") }/>
			<link rel="preload" href={ assets.URL("fonts/inter-var.woff2") } as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="stylesheet" href={ assets.URL("css/tokens.css") }/>
			<link rel="stylesheet" href={ assets.URL("css/base.css") }/>
			<link rel="stylesheet" href={ assets.URL("css/components.css") }/>
			for _, name := range page.Styles {
				<link rel="stylesheet" href={ assets.URL(name) }/>
			}
			if accentCSS != "" {
				@templ.Raw("<style>" + accentCSS + "</style>")
			}
		</head>
		<body class="public">
			{ children... }
		</body>
	</html>
}

// PublicStatusPage is a status page as its visitors see it (docs/12
// "Layouts", docs/33 "Status page components"): one component per layout,
// each arranging the shared partials below, and that layout's stylesheet.
templ PublicStatusPage(v PublicPage, theme string) {
	{{ layout := publicLayout(v.Layout) }}
	@PublicLayout(publicPage(v.Title, theme, layout), v.AccentCSS, v.NoIndex, true) {
		switch layout {
			case LayoutSignal:
				@signalPage(v)
			case LayoutSentence:
				@sentencePage(v)
		}
	}
}

// signalPage is the Signal layout (docs/12 "Signal"): one answer at a
// glance. data-overall sets --lamp, the colour of the lamp, its ring and
// its halo (public_signal.css); data-state on the hero colours the
// Ambient light behind it.
templ signalPage(v PublicPage) {
	<div class="public-page" data-layout="signal" data-overall={ v.Overall }>
		@publicHeader(v)
		<main>
			<section class="public-hero signal-hero" data-state={ v.HeroState } aria-labelledby="overall">
				@statusLamp(v.Overall)
				<h1 id="overall">{ signalHeadline(v) }</h1>
				<p class="signal-meta">{ signalMeta(v) }Updated <time datetime={ v.GeneratedAt }>{ v.Generated }</time></p>
				if v.Note != nil {
					@publicNote(*v.Note)
				}
			</section>
			for _, g := range v.Groups {
				@signalGroup(g)
			}
			if len(v.Groups) > 0 {
				@publicAxis()
			}
			<section class="signal-incidents" aria-labelledby="incidents">
				<h2 id="incidents">Incidents</h2>
				if len(v.Incidents) == 0 {
					<p class="public-quiet">No incidents in the last { pluralDays(v.IncidentDays) }.</p>
				} else {
					<ol class="signal-incident-list" role="list">
						for _, in := range v.Incidents {
							@signalIncident(in)
						}
					</ol>
				}
			</section>
		</main>
		@publicFooter(v)
	</div>
}

// statusLamp is the hero's lamp (docs/04 "Status lamp"): the halo that
// breathes, the lit bulb and the overall state's glyph inside it. The
// headline next to it carries the words, so the lamp is decoration to a
// reader.
templ statusLamp(overall string) {
	<div class="signal-lamp" aria-hidden="true">
		<span class="signal-halo"></span><span class="signal-bulb">@Icon(overallIcon(overall))</span>
	</div>
}

// signalGroup is a group's name with its summary in words on the right,
// then its services as cards in two columns (one on phones).
templ signalGroup(g PublicGroup) {
	{{ summary, state := signalGroupSummary(g) }}
	<section class="signal-group" aria-label={ groupLabel(g) }>
		<div class="signal-group-head">
			<h2 class="signal-group-name">{ groupLabel(g) }</h2>
			<p
				class="signal-group-summary"
				if state != "" {
					data-state={ state }
				}
			>{ summary }</p>
		</div>
		<ul class="signal-cards" role="list">
			for _, row := range g.Rows {
				@signalCard(row)
			}
		</ul>
	</section>
}

// signalCard is one service: a mini lamp, its name, its state in words
// (Terminal shows the tag) with the latency where shown, the 90-day uptime
// figure on the right and the strip under them.
templ signalCard(row PublicRow) {
	<li class="signal-card" data-state={ row.State }>
		<div class="signal-card-head">
			<div class="signal-card-id">
				<p class="signal-card-name"><span class="signal-dot"></span>{ row.Name }</p>
				<p class="signal-card-state"><span class="status-text">{ publicStateLabel(row.State) }</span><span class="status-tag" aria-hidden="true">{ publicStateTag(row.State) }</span>{ signalLatency(row) }</p>
			</div>
			<p class="signal-card-figure"><span class="signal-card-uptime">{ row.Uptime }</span><small>90-day uptime</small></p>
		</div>
		@PublicDayBars(row)
	</li>
}

// signalIncident is one listed incident: its day and time, the service
// with an Ongoing or Resolved badge, how long it was (or has been) down,
// and its notes.
templ signalIncident(in PublicIncident) {
	<li class="signal-incident" data-active?={ in.Active }>
		<p class="signal-incident-when"><time datetime={ in.StartedAt }>{ in.Date }, { in.Time }</time></p>
		<div class="signal-incident-body">
			<p class="signal-incident-head"><span class="signal-incident-service">{ in.Service }</span><span class="signal-badge">{ signalBadge(in.Active) }</span></p>
			<p class="signal-incident-duration">
				if in.Active {
					Down for { in.Short } so far
				} else {
					Down for { in.Short }
				}
			</p>
			@publicNotes(in.Notes)
		</div>
	</li>
}

// sentencePage is the Sentence layout (docs/12 "Sentence"): the page reads
// like a short note. data-overall colours the rule across the top of the
// page, the headline's verb and the quote's rule (public_sentence.css).
templ sentencePage(v PublicPage) {
	<div class="public-page" data-layout="sentence" data-overall={ v.Overall }>
		@publicHeader(v)
		<main>
			<section class="sentence-hero" aria-labelledby="overall">
				switch v.Overall {
					case OverallNone:
						<h1 id="overall">Nothing is monitored on this page yet.</h1>
					case OverallUp:
						<h1 id="overall">Everything at { v.Title } is working.</h1>
						<p class="sentence-sub">{ v.LastIssue }</p>
					default:
						<h1 id="overall">{ v.Names }{ " " }<span class="sentence-verb">{ v.Verb }.</span></h1>
						if sub := sentenceSub(v); sub != "" {
							<p class="sentence-sub">{ sub }</p>
						}
						if v.Note != nil {
							@publicNote(*v.Note)
						}
				}
				<p class="sentence-meta">Updated <time datetime={ v.GeneratedAt }>{ v.Generated }</time>{ sentenceMeta(v) }</p>
			</section>
			for _, g := range v.Groups {
				@publicGroup(g)
			}
			if len(v.Groups) > 0 {
				@publicAxis()
			}
			<section class="public-incidents" aria-labelledby="incidents">
				<h2 class="public-group-name" id="incidents">The last { pluralDays(v.IncidentDays) }</h2>
				if len(v.Incidents) == 0 {
					<p class="public-quiet">No incidents in the last { pluralDays(v.IncidentDays) }.</p>
				} else {
					<ol class="public-incident-list" role="list">
						for _, in := range v.Incidents {
							@publicIncident(in)
						}
					</ol>
				}
			</section>
		</main>
		@publicFooter(v)
	</div>
}

// publicGroup is a group's label over its services. Services outside any
// group are labelled "Services".
templ publicGroup(g PublicGroup) {
	<section class="public-group" aria-label={ groupLabel(g) }>
		<h2 class="public-group-name">{ groupLabel(g) }</h2>
		<ul class="public-services" role="list">
			for _, row := range g.Rows {
				@publicRow(row)
			}
		</ul>
	</section>
}

// publicRow is one service: its name, a dotted leader and its state in
// words (Terminal shows the tag instead); under it the 90-day strip and
// its downtime in human time.
templ publicRow(row PublicRow) {
	<li class="public-service" data-state={ row.State }>
		<div class="public-service-head">
			<span class="public-service-name">{ row.Name }</span>
			<span class="public-service-state">
				<span class="public-glyph">@Icon(publicStateIcon(row.State))</span>
				<span class="status-text">{ publicStateLabel(row.State) }</span><span class="status-tag" aria-hidden="true">{ publicStateTag(row.State) }</span>
			</span>
		</div>
		<div class="public-service-strip">
			@PublicDayBars(row)
			if row.Downtime != "" {
				<span class="public-service-downtime">{ row.Downtime }</span>
			}
		</div>
	</li>
}

// The partials every layout shares (docs/12 "What every layout shares").

// publicHeader is the logo, the title, the description and the Subscribe
// link to the page's feed. The title is not a heading: the page's h1 is
// its status.
templ publicHeader(v PublicPage) {
	<header class="public-header">
		if v.Logo != "" {
			<img class="public-logo" src={ v.Logo } alt=""/>
		}
		<div class="public-title">
			<p class="public-title-name">{ v.Title }</p>
			if v.Description != "" {
				<p class="public-description">{ v.Description }</p>
			}
		</div>
		if v.FeedURL != "" {
			<a class="public-subscribe" href={ templ.SafeURL(v.FeedURL) }>
				@Icon("rss")
				<span>Subscribe</span>
			</a>
		}
	</header>
}

// publicFooter is the time zone note and "Powered by Sinjal", which the
// page may turn off.
templ publicFooter(v PublicPage) {
	<footer class="public-footer">
		<p>Times in { v.Zone }. The page refreshes every minute.</p>
		if v.PoweredBy {
			<p>Powered by <a href="https://github.com/drilonrecica/sinjal">Sinjal</a></p>
		}
	</footer>
}

// publicNote is the newest published note of an ongoing incident, shown
// in the hero as a quote with its time and service.
templ publicNote(n PublicNote) {
	<blockquote class="public-hero-note">
		<p>{ n.Message }</p>
		<p class="public-hero-note-meta">Update at <time datetime={ n.At }>{ n.Time }</time>{ " · " + n.Service }</p>
	</blockquote>
}

// publicIncident is one listed incident as a sentence, with its day on
// the side and its published notes as quotes with their times.
templ publicIncident(in PublicIncident) {
	<li class="public-incident" data-active?={ in.Active }>
		<p class="public-incident-date"><time datetime={ in.StartedAt }>{ in.Date }</time></p>
		<div class="public-incident-body">
			<p class="public-incident-text">
				if in.Active {
					{ in.Service } has been down since <time datetime={ in.StartedAt }>{ in.Time }</time>.
				} else {
					{ in.Service } was down for { in.Long }, from <time datetime={ in.StartedAt }>{ in.Time }</time>.
				}
			</p>
			@publicNotes(in.Notes)
		</div>
	</li>
}

// publicNotes are an incident's published notes, each a quote with its
// time after it; every layout quotes them the same way.
templ publicNotes(notes []PublicNote) {
	for _, n := range notes {
		<p class="public-note"><q>{ n.Message }</q>{ " " }<time datetime={ n.At }>{ n.Time }</time></p>
	}
}

// PublicDayBars is a service's 90-day strip in the "Monitoring since"
// form: the days before its first day with data are a dashed line, with
// the label over it when there is room (sinceFits).
templ PublicDayBars(row PublicRow) {
	@DayBarsSince(row.Days, row.SinceDay, sinceText(row), row.StripText)
}

// publicAxis is the page's one "90 days ago … Today" axis, under the last
// strips. The strips' own labels carry their dates.
templ publicAxis() {
	<p class="public-axis" aria-hidden="true"><span>90 days ago</span><span>Today</span></p>
}

// PublicPasswordPage asks for a page's password (docs/12 "Password-protected").
templ PublicPasswordPage(v PublicPasswordView, theme string) {
	@PublicLayout(publicPage(v.Title, theme, ""), "", false, false) {
		<div class="public-page public-locked">
			<main>
				<h1>{ v.Title }</h1>
				<form class="public-password" method="post" action={ templ.SafeURL(v.Action) }>
					if v.CSRFToken != "" {
						<input type="hidden" name="_csrf" value={ v.CSRFToken }/>
					}
					<label for="password">This page is protected. Enter its password to see it.</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						if v.Error != "" {
							aria-invalid="true"
							aria-describedby="password-error"
						}
					/>
					if v.Error != "" {
						<p id="password-error" class="public-error" role="alert">{ v.Error }</p>
					}
					<button type="submit">Open the page</button>
				</form>
			</main>
		</div>
	}
}

// PublicMessagePage explains why a page cannot be shown here.
templ PublicMessagePage(title, message, theme string) {
	@PublicLayout(publicPage(title, theme, ""), "", false, false) {
		<div class="public-page public-locked">
			<main>
				<h1>{ title }</h1>
				<p>{ message }</p>
			</main>
		</div>
	}
}
