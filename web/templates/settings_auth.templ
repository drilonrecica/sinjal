package templates

import "strconv"

// settingsFrame is the app shell around a settings page. Minimal until the
// settings layout lands (M1-18).
templ settingsFrame(page Page) {
	@Shell(page.withAssets([]string{"css/auth.css", "css/settings.css"}, []string{"js/passkey.js"}), "settings") {
		<div class="settings">
			{ children... }
		</div>
	}
}

// SettingsAuth is Settings → Authentication: the signed-in admin's own
// sign-in methods.
templ SettingsAuth(page Page, v SettingsAuthView) {
	@settingsFrame(page) {
		<h1>Authentication</h1>
		<section class="settings-section" aria-labelledby="password-heading">
			<h2 id="password-heading">Password</h2>
			<p><a href="/account/password">Change your password</a></p>
		</section>
		<section class="settings-section" aria-labelledby="totp-heading">
			<h2 id="totp-heading">Authenticator app</h2>
			if v.TOTPEnabled {
				<p><strong>On.</strong> Signing in with your password also asks for a 6-digit code from your authenticator app.</p>
				<form method="post" action="/settings/authentication/totp/disable">
					@CSRFField(page)
					<button class="settings-button" type="submit">Turn off</button>
				</form>
				<p class="auth-hint">To move to a new phone, turn it off and set it up again.</p>
			} else {
				<p><strong>Off.</strong> Add a 6-digit code from an authenticator app (TOTP) as a second step after your password.</p>
				<p><a href="/settings/authentication/totp">Set up an authenticator app</a></p>
			}
		</section>
		<section class="settings-section" aria-labelledby="passkeys-heading">
			<h2 id="passkeys-heading">Passkeys</h2>
			<p>A passkey signs you in with this device's fingerprint, face or PIN, without the password and the authenticator code.</p>
			if len(v.Passkeys) == 0 {
				<p><strong>None yet.</strong></p>
			} else {
				<ul class="passkey-list" role="list">
					for _, k := range v.Passkeys {
						<li>
							<span class="passkey-label">{ k.Label }</span>
							<span class="passkey-meta">Added { k.Added } · { k.LastUsed }</span>
							<form method="post" action={ templ.SafeURL("/settings/authentication/passkeys/" + k.ID + "/delete") }>
								@CSRFField(page)
								<button class="settings-button" type="submit" aria-label={ "Remove passkey " + k.Label }>Remove</button>
							</form>
						</li>
					}
				</ul>
			}
			if v.PasskeysUnavailable != "" {
				<p class="auth-hint">Passkeys cannot be added on this server. { v.PasskeysUnavailable }</p>
			} else {
				@passkeyButton("create", "/settings/authentication/passkeys/begin", "/settings/authentication/passkeys/finish", "", "settings-button", "Add a passkey") {
					<div class="auth-field">
						<label for="passkey-label">Name for the new passkey</label>
						<input id="passkey-label" type="text" maxlength="64" autocomplete="off" aria-describedby="passkey-label-hint" data-passkey-label/>
						<p id="passkey-label-hint" class="auth-hint">Optional. For example the device it is stored on.</p>
					</div>
				}
			}
		</section>
		<section class="settings-section" aria-labelledby="viewers-heading">
			<h2 id="viewers-heading">Viewers</h2>
			<p>Viewers can look at everything but change nothing, and they never see secrets. Give them the username and password yourself; they can change the password after signing in.</p>
			if len(v.Viewers) == 0 {
				<p><strong>No viewers yet.</strong></p>
			} else {
				<ul class="passkey-list" role="list">
					for _, u := range v.Viewers {
						<li>
							<span class="passkey-label">{ u.Login }</span>
							<span class="passkey-meta">
								if u.Disabled {
									Disabled
								} else {
									Active
								}
								· Added { u.Added }
							</span>
							if u.Disabled {
								<form method="post" action={ templ.SafeURL("/settings/authentication/viewers/" + u.ID + "/enable") }>
									@CSRFField(page)
									<button class="settings-button" type="submit" aria-label={ "Enable " + u.Login }>Enable</button>
								</form>
							} else {
								<form method="post" action={ templ.SafeURL("/settings/authentication/viewers/" + u.ID + "/disable") }>
									@CSRFField(page)
									<button class="settings-button" type="submit" aria-label={ "Disable " + u.Login }>Disable</button>
								</form>
							}
						</li>
					}
				</ul>
			}
			<h3>Add a viewer</h3>
			<form class="auth-form" method="post" action="/settings/authentication/viewers">
				@CSRFField(page)
				@field("login", "Username", v.ViewerForm.Errors) {
					<input id="login" name="login" type="text" value={ v.ViewerForm.Login } autocomplete="off" autocapitalize="none" spellcheck="false" required maxlength="64" { fieldAttrs("login", v.ViewerForm.Errors)... }/>
				}
				@field("password", "Password", v.ViewerForm.Errors) {
					<input id="password" name="password" type="password" autocomplete="new-password" required minlength={ strconv.Itoa(v.MinPassword) } { fieldAttrs("password", v.ViewerForm.Errors, "password-hint")... }/>
					<p id="password-hint" class="auth-hint">At least { strconv.Itoa(v.MinPassword) } characters.</p>
				}
				@field("confirm", "Confirm password", v.ViewerForm.Errors) {
					<input id="confirm" name="confirm" type="password" autocomplete="new-password" required { fieldAttrs("confirm", v.ViewerForm.Errors)... }/>
				}
				<button class="auth-submit" type="submit">Add viewer</button>
			</form>
		</section>
	}
}

// TOTPSetup shows a new TOTP secret as QR code, key and link, and asks for
// the first code to confirm the app has it.
templ TOTPSetup(page Page, v TOTPSetupView) {
	@settingsFrame(page) {
		<h1>Set up an authenticator app</h1>
		if v.Error != "" {
			<p class="auth-alert" role="alert">{ v.Error }</p>
		}
		<ol class="settings-steps">
			<li>
				<p>Scan this QR code with your authenticator app.</p>
				<img class="totp-qr" src={ v.QR } alt="QR code containing the setup key"/>
				<p>If you cannot scan it, enter this setup key in the app: <code class="totp-secret">{ v.Secret }</code></p>
				<details>
					<summary>Show the setup link</summary>
					<code class="totp-uri">{ v.URI }</code>
				</details>
			</li>
			<li>
				<p>Enter the code the app shows to turn it on.</p>
				<form class="auth-form" method="post" action="/settings/authentication/totp">
					@CSRFField(page)
					<input type="hidden" name="pending" value={ v.Pending }/>
					@codeField("6-digit code", true)
					<button class="auth-submit" type="submit">Turn on</button>
				</form>
			</li>
		</ol>
		<p><a href="/settings/authentication">Cancel</a></p>
	}
}
