package templates

// Shell is the application frame: skip link, sidebar navigation and the main
// region. active is the Key of the current Section ("" for none).
templ Shell(page Page, active string) {
	@Layout(page.withAssets([]string{"css/shell.css"}, []string{"js/htmx.min.js"})) {
		<a class="skip-link" href="#main">Skip to main content</a>
		<div class="shell">
			<div class="sidebar">
				<header class="brand">
					<a class="brand-link" href="/">Sinjal</a>
				</header>
				<nav class="nav" aria-label="Primary">
					<ul role="list">
						for _, s := range Sections {
							<li>
								<a
									class="nav-link"
									href={ templ.SafeURL(s.Path) }
									if s.Key == active {
										aria-current="page"
									}
								>{ s.Label }</a>
							</li>
						}
					</ul>
				</nav>
			</div>
			<main id="main" class="content" tabindex="-1">
				{ children... }
			</main>
		</div>
	}
}

// Placeholder is the body of a section that has not been built yet.
templ Placeholder(title string) {
	<h1>{ title }</h1>
	<p class="placeholder">This section has not been built yet.</p>
}

// PlaceholderPage renders the shell around the placeholder for one section.
templ PlaceholderPage(page Page, s Section) {
	@Shell(page, s.Key) {
		@Placeholder(s.Label)
	}
}
