package templates

// ColumnList is the shell's monitor list column (docs/03 "Layout"): one
// compact row per monitor. The shell loads it once from /fragments/monitors
// and it replaces itself from there when live.js sends it "refresh", which
// it does when a monitor is created or deleted.
templ ColumnList(ms []MonitorView, admin bool, query string, filtered bool) {
	<ul
		class="column-list"
		role="list"
		data-live-list
		hx-get={ columnListURL(query) }
		hx-trigger="refresh"
		hx-swap="outerHTML"
	>
		for _, m := range ms {
			@ColumnRow(m)
		}
	</ul>
	if len(ms) == 0 && filtered {
		<div class="column-empty">
			<p>No monitors match.</p>
		</div>
	} else if len(ms) == 0 {
		<div class="column-empty">
			<p>No monitors yet.</p>
			if admin {
				<p><a href="/monitors/new">Create the first one</a></p>
			}
		</div>
	}
}

// ColumnRow is one monitor in the column: its state (glyph, with the word
// for assistive technology), name, 24-hour uptime and beat bar, all one
// link into the pane. It replaces itself from /fragments/monitors/{id}/row
// on every update of its monitor; shell.js marks the row of the monitor in
// the pane.
templ ColumnRow(m MonitorView) {
	<li
		class="column-row"
		id={ "col-" + m.ID }
		data-live
		data-monitor-id={ m.ID }
		data-state={ m.State }
		hx-get={ "/fragments/monitors/" + m.ID + "/row" }
		hx-trigger="refresh"
		hx-swap="outerHTML"
	>
		<a class="column-link" href={ templ.SafeURL("/monitors/" + m.ID) }>
			<span class="column-status" data-state={ m.State }>
				@Icon(stateIcon(m.State))
				<span class="visually-hidden">{ stateLabel(m.State) }:</span>
			</span>
			<span class="column-name">{ m.Name }</span>
			<span class="column-uptime" title="Uptime, last 24 hours">{ m.Uptime }</span>
			@BeatBar(m.Beats)
		</a>
	</li>
}
