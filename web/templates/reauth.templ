package templates

// Reauth asks the signed-in user to confirm their password (and TOTP code,
// when enabled), or a passkey, before a sensitive action.
templ Reauth(page Page, f ReauthForm) {
	@authFrame(page.withAssets(nil, passkeyScripts(f.Passkey))) {
		<h1>Confirm it's you</h1>
		if f.TOTP {
			<p class="auth-lead">Enter your password and authentication code to continue. Sensitive changes need a recent confirmation.</p>
		} else {
			<p class="auth-lead">Enter your password to continue. Sensitive changes need a recent confirmation.</p>
		}
		if f.Error != "" {
			<p class="auth-alert" role="alert">{ f.Error }</p>
		}
		<form class="auth-form" method="post" action="/reauth">
			@CSRFField(page)
			if f.Next != "" {
				<input type="hidden" name="next" value={ f.Next }/>
			}
			<input type="text" name="username" value={ f.Login } autocomplete="username" hidden/>
			<div class="auth-field">
				<label for="password">Password for { f.Login }</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required autofocus/>
			</div>
			if f.TOTP {
				@codeField("Authentication code", false)
			}
			<button class="auth-submit" type="submit">Continue</button>
		</form>
		if f.Passkey {
			@passkeyButton("get", "/reauth/passkey/begin", "/reauth/passkey/finish", f.Next, "auth-secondary", "Use a passkey instead")
		}
	}
}
