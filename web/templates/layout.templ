package templates

import "github.com/drilonrecica/sinjal/internal/assets"

// CSRFField is the hidden CSRF token input every POST form includes.
// It renders nothing on anonymous pages.
templ CSRFField(page Page) {
	if page.CSRFToken != "" {
		<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
	}
}

// Layout is the document skeleton shared by every page.
templ Layout(page Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ page.Theme } data-density={ page.Density }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ page.ColorScheme() }/>
			<title>{ page.Title }</title>
			<link rel="stylesheet" href={ assets.URL("css/tokens.css") }/>
			<link rel="stylesheet" href={ assets.URL("css/base.css") }/>
			for _, name := range page.Styles {
				<link rel="stylesheet" href={ assets.URL(name) }/>
			}
			for _, name := range page.Scripts {
				<script src={ assets.URL(name) } defer></script>
			}
		</head>
		<body
			if page.CSRFToken != "" {
				hx-headers={ page.HXHeaders() }
			}
		>
			{ children... }
		</body>
	</html>
}
