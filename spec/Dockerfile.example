# Directional example; M10-07 implements the real Dockerfile (decision P0-03).
# Runtime base is scratch: no shell, no package manager, nothing to patch.

ARG GO_VERSION=1.27

FROM golang:${GO_VERSION} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# timetzdata embeds the zoneinfo database so SINJAL_TIMEZONE works in scratch.
RUN CGO_ENABLED=0 go build -trimpath -tags timetzdata -ldflags "-s -w" \
      -o /out/sinjal ./cmd/sinjal \
 && mkdir -p /out/data

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/sinjal /sinjal
COPY --from=build --chown=65532:65532 /out/data /data

USER 65532:65532
ENV SINJAL_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8080

# No curl/wget in scratch: the binary checks its own /healthz.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/sinjal", "healthcheck"]

ENTRYPOINT ["/sinjal"]
